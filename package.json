{
  "name": "study-tutor",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/server.test.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "test:all": "node tests/run-all.mjs",
    "bundle": "node tools/gen-persona.mjs && cd server && npx -y esbuild@0.24.0 worker.js --bundle --format=esm --platform=neutral --outfile=worker-bundle.js",
    "start": "node server/node.mjs",
    "test:live": "node tests/live.test.mjs",
    "test:conversation": "node tests/conversation.test.mjs",
    "test:puter": "node tests/puter-voice.test.mjs",
    "test:study": "node tests/study.test.mjs",
    "test:cloud": "node tests/cloud.test.mjs",
    "lint": "eslint .",
    "test:quality": "node tests/quality.test.mjs",
    "test:scale": "node tests/scale.test.mjs",
    "test:rls": "python3 tests/rls.test.py",
    "test:regress": "node tests/regress.test.mjs",
    "test:worksheet": "node tests/worksheet.test.mjs",
    "check": "node tests/run-all.mjs lint server",
    "postinstall": "playwright install chromium || echo 'playwright browsers: set PLAYWRIGHT_BROWSERS_PATH or run npx playwright install chromium'"
  },
  "devDependencies": {
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "playwright": "^1.56.0",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1"
  }
}
