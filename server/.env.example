# انسخ الملف ده لـ server/.env (أو حط القيم كـ secrets في Cloudflare). متحطش الملف ده في GitHub بعد ما تكتب المفاتيح.

# المواقع المسموح لها تستخدم السيرفر (رابط GitHub Pages بتاعك). "*" = أي موقع (مش مستحسن).
ALLOWED_ORIGINS=https://YOUR-NAME.github.io

# ===== الذكاء (واحد بس يكفي) =====
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   (أي خدمة متوافقة مع OpenAI)
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=anthropic | gemini | openai    (تلقائي حسب المفتاح الموجود)

# ===== البحث بالمعنى (embeddings) — تلقائي: Gemini ثم OpenAI =====
# EMBED_PROVIDER=gemini | openai

# ===== تحويل النص لصوت (TTS) — طبقة مستقلة، مفيش Gemini =====
# ----- إعدادات صوت المدرّس المركزية (مكان واحد — الشرح الكامل في server/voice-config.js) -----
# VOICE_PROVIDER=azure              ← المحرك الأساسي (نفس TTS_PROVIDER، وبيغلبه لو الاتنين موجودين)
# VOICE_ID=ar-EG-ShakirNeural       ← صوت واحد للعربي والإنجليزي والمخلوط (ElevenLabs: ID الصوت، OpenAI: ash)
# VOICE_NAME=شاكر
# VOICE_MODEL=                      ← ElevenLabs: eleven_multilingual_v2 — OpenAI: gpt-4o-mini-tts
# VOICE_SPEED=0.95                  ← 0.7–1.3 (سرعة أساسية هادية؛ سرعة الطالب بتتضرب فيها)
# VOICE_STABILITY=0.45              ← ElevenLabs (أقل = تعبير أكتر)
# VOICE_SIMILARITY=0.8              ← ElevenLabs
# VOICE_STYLE=0.25                  ← ElevenLabs رقم 0–1 — أو نص = تعليمات أسلوب لـ OpenAI
# VOICE_ONE=true                    ← false = صوت عربي + صوت إنجليزي منفصلين (القديم)
# الترتيب: TTS_PROVIDER (قايمة بفاصلة) وإلا تلقائي: piper ← openai_compatible ← azure ← elevenlabs ← openai. ولو محرك فشل اللي بعده بيتجرّب.
# TTS_PROVIDER=piper,azure        ← دول بس وبالترتيب ده (أي اسم غلط بيظهر كتحذير في /v1/health)
# TTS_AUTO_FALLBACK=true          ← وبعدهم أي محرك تاني متظبط لو اللي فوق وقعوا
# TTS_TIMEOUT_MS=20000            ← أقصى وقت لكل طلب لمحرك الصوت (بعده بيتجرّب اللي بعده)
# MAX_TTS_CHARS=1500

# Piper (مفتوح المصدر على سيرفرك — الموصى بيه): python3 -m piper.http_server -m ar_JO-kareem-medium --port 5000
# PIPER_URL=http://127.0.0.1:5000
# PIPER_VOICES=[{"id":"ar_JO-kareem-medium","name":"كريم","lang":"ar","gender":"m","default":true},{"id":"en_US-ryan-medium","name":"Ryan","lang":"en","gender":"m","default":true}]

# أي سيرفر TTS متوافق مع OpenAI (استضافة ذاتية / صوتك المستنسخ)
# TTS_OAI_URL=http://127.0.0.1:8000/v1
# TTS_OAI_KEY=
# TTS_OAI_MODEL=tts-1
# TTS_OAI_VOICES=[{"id":"my-voice","name":"صوتي","lang":"ar","gender":"m","default":true}]

# Azure Speech (أصوات مصرية Neural + طبقة صوت)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_VOICES=[{"id":"ar-EG-ShakirNeural","name":"شاكر","lang":"ar","gender":"m","default":true},{"id":"en-US-AndrewMultilingualNeural","name":"Andrew","lang":"en","gender":"m","default":true}]

# ElevenLabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICES=[{"id":"<voice id>","name":"...","lang":"ar","gender":"m","default":true}]

# OpenAI TTS (بيستخدم OPENAI_API_KEY) — لو المفتاح ده للشات بس:
# OPENAI_TTS_DISABLED=true

# ===== تحويل الكلام لنص (للمتصفحات اللي مفيهاش ميكروفون ذكي زي Firefox) — أي خدمة متوافقة مع OpenAI =====
# STT_API_KEY=            (افتراضي: OPENAI_API_KEY)
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3

# RATE_LIMIT_MULTIPLIER=1

# ===== الحسابات (اختياري — Supabase) =====
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=...            ← المفتاح العام (anon) بس. متحطش service_role أبدًا.
# REQUIRE_AUTH=true                ← الذكاء والصوت للمستخدمين المسجّلين بس (والحد لكل مستخدم)
# SUPABASE_SERVICE_ROLE_KEY=...    ← للسيرفر بس (مسح الحساب نهائيًا). عمره ما يتحط في config.js ولا يتبعت للموقع.
#                                     من غيره: /v1/account/delete بيرجّع 501 no_admin (والمستخدم يقدر يمسح بياناته بس).

# ===== حدود الاستخدام اليومية (لكل مستخدم مسجّل، وإلا لكل IP) =====
# QUOTA_CHAT_PER_DAY=500
# QUOTA_IMAGES_PER_DAY=100
# QUOTA_TTS_CHARS_PER_DAY=300000
# QUOTA_STT_BYTES_PER_DAY=100000000
# QUOTA_EMBED_TEXTS_PER_DAY=20000
# COST_PER_1K_OUTPUT_CHARS=0.002   ← تقدير تكلفة بيظهر في /v1/usage (اختياري)

# ===== السجلات =====
# LOG=off                          ← يقفل سجلات JSON (السجلات أصلاً مفيهاش مفاتيح ولا نص الكتب/الأسئلة)

# ===== سلسلة الشات (اللي يخلص حصته ينط للي بعده) =====
# الأسهل: افتح /admin على السيرفر وحط المفاتيح من هناك. أو حطها هنا / كـ Secrets:
# GROQ_API_KEY=            # https://console.groq.com/keys  (مجاني)
# OPENROUTER_API_KEY=      # https://openrouter.ai/settings/keys  (فيه موديلات :free)
# LLM_ORDER=gemini,groq,openrouter,cloudflare,anthropic,openai
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# ADMIN_PASSWORD=          # اختياري: باسورد لوحة التحكم (وإلا بتختاره أول مرة تفتح /admin)
